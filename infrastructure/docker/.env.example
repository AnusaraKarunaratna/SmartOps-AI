# Environment variables for Docker Compose environment

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_INITDB_ARGS=-c shared_buffers=256MB -c max_connections=200

# Kafka Configuration
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# Spring Boot - Common
SPRING_PROFILES_ACTIVE=docker
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT Configuration
JWT_SECRET=smartops-secret-key-123456smartops-secret-key-123456
JWT_EXPIRATION=86400000

# Database URLs (Docker Compose - services communicate via container names)
AUTH_DB_URL=jdbc:postgresql://postgres:5432/auth_service_db
INVENTORY_DB_URL=jdbc:postgresql://postgres:5432/inventory_db
SALES_DB_URL=jdbc:postgresql://postgres:5432/sales_db
ANALYTICS_DB_URL=jdbc:postgresql://postgres:5432/analytics_db
NOTIFICATION_DB_URL=jdbc:postgresql://postgres:5432/notification_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka Brokers (Docker Compose)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Application URLs (for inter-service communication)
AUTH_SERVICE_URL=http://auth-service:8081
GATEWAY_SERVICE_URL=http://gateway-service:8082
INVENTORY_SERVICE_URL=http://inventory-service:8083
SALES_SERVICE_URL=http://sales-service:8085
NOTIFICATION_SERVICE_URL=http://notification-service:8084
ANALYTICS_SERVICE_URL=http://analytics-service:8086
AI_SERVICE_URL=http://ai-prediction-service:8090

# Logging
LOG_LEVEL=INFO
